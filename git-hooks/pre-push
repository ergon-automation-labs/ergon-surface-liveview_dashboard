#!/bin/bash
# Git pre-push hook for bot_army_dashboard_liveview (Phoenix LiveView surface)
# Validates compilation and builds release before pushing to main. Jenkins deploys from GitHub releases.

set -e

echo "🔍 Running pre-push checks..."
echo ""

# Check if we're pushing to main
#
# Git runs this hook with empty stdin when the branch is already up to date (or
# when the ref update is a no-op), so a bare `read` under `set -e` killed the
# hook with no output at all — the operator saw only "error: failed to push some
# refs" and no reason. Fail closed, but say why.
if ! read -r local_ref local_oid remote_ref remote_oid; then
  echo "❌ pre-push: no refs on stdin — this branch has nothing to push."
  echo "   If you expected a push, the commit is probably missing: this hook (and"
  echo "   'make push') validates and pushes; neither one commits for you."
  exit 1
fi
if [[ $remote_ref == "refs/heads/main" ]]; then
  echo "⚠️  Pushing to main branch - validating and building release..."
  echo ""

  echo "📦 Installing dependencies..."
  mix deps.get || {
    echo "❌ Failed to install dependencies"
    exit 1
  }

  echo ""
  echo "🔨 Compiling code..."
  mix compile --force || {
    echo "❌ Compilation failed - push aborted"
    exit 1
  }

  echo ""
  echo "📝 Running linter (optional)..."
  mix credo --strict 2>/dev/null || true

  echo ""
  echo "📦 Building OTP release..."
  MIX_ENV=prod mix release --overwrite || {
    echo "❌ Release build failed - push aborted"
    exit 1
  }

  echo ""
  echo "🚀 Publishing release to GitHub..."
  RELEASE_NAME="bot_army_dashboard_liveview"
  VERSION=$(cat _build/prod/rel/"$RELEASE_NAME"/releases/start_erl.data 2>/dev/null | awk '{print $2}')
  if [ -z "$VERSION" ]; then
    echo "❌ Could not read release version"
    exit 1
  fi
  echo "Version: $VERSION"

  tar -czf "$RELEASE_NAME-$VERSION.tar.gz" -C _build/prod/rel "$RELEASE_NAME"/ || {
    echo "❌ Failed to create tarball"
    exit 1
  }
  echo "✓ Tarball created: $RELEASE_NAME-$VERSION.tar.gz"

  REPO="ergon-automation-labs/ergon-surface-liveview_dashboard"
  ASSET="$RELEASE_NAME-$VERSION.tar.gz"

  if ! gh release create "v$VERSION" "$ASSET" \
    --repo "$REPO" \
    --title "Release v$VERSION" \
    --notes "Phoenix LiveView surface bot_army_dashboard_liveview v$VERSION. Deployed by Jenkins." \
    --draft=false; then
    # "Already exists" is not the same as "published". A release whose asset
    # upload failed is a release with no tarball, and the salt state resolves the
    # version from `gh release list` and downloads that asset *by name*: it would
    # find the new version, fail to download it, and leave the old version live
    # while this hook printed a tick. Upload the asset explicitly, clobbering, so
    # a half-created release is repaired rather than mistaken for a finished one.
    if ! gh release upload "v$VERSION" "$ASSET" --repo "$REPO" --clobber; then
      echo "❌ Could not publish v$VERSION: release create and asset upload both failed"
      exit 1
    fi
    echo "ℹ️  v$VERSION already existed — its tarball is in place"
  fi

  # Prove it rather than announce it: the deploy downloads this exact asset name,
  # so the asset's presence is what "published" means.
  if ! gh release view "v$VERSION" --repo "$REPO" --json assets --jq '.assets[].name' \
    | grep -qx "$ASSET"; then
    echo "❌ v$VERSION has no $ASSET asset — a deploy would silently stay on the old version"
    exit 1
  fi
  echo "✓ Release published to GitHub: v$VERSION (tarball verified present)"

  echo ""
  echo "✅ All checks passed, release built and published!"
  echo "📤 Proceeding with push..."
else
  echo "ℹ️  Pushing to feature branch - skipping validation"
fi

echo ""
exit 0
